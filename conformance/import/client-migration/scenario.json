{
  "mode": "client-migration",
  "rule": "Migration negotiates import support, bounds chunks, stops on the first 4xx, excludes install-check by default, counts exclusions only before the selected-record limit is reached, and makes dry-run read-only.",
  "seed": [
    {"kind":"friction","summary":"first migration record"},
    {"kind":"friction","summary":"second migration record"},
    {"kind":"install-check","summary":"migration installation probe"}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfeedback.dev/schemas/kinds/review.v1.json",
  "title": "Review: one completed multi-reviewer run",
  "type": "object",
  "additionalProperties": true,
  "x-recommended": ["skill", "reviewers"],
  "properties": {
    "skill":  { "type": "string", "x-max-bytes": 200, "description": "The runner that produced the run." },
    "prompt": { "type": "string" },
    "target": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "ref":      { "type": "string", "description": "branch, tag or commit reviewed" },
        "pr":       { "type": "string" },
        "diff_sha": { "type": "string" }
      }
    },
    "grader": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "model":   { "type": "string" },
        "session": { "type": "string" }
      }
    },
    "reviewers": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "x-unique-by": "slot",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "x-recommended": ["slot", "model", "status"],
        "properties": {
          "slot":       { "type": "string", "x-max-bytes": 200 },
          "model":      { "type": "string", "x-max-bytes": 200 },
          "status":     { "type": "string", "x-max-bytes": 200, "examples": ["completed", "timeout", "error"] },
          "duration_s": { "type": "number",  "minimum": 0 },
          "bytes":      { "type": "integer", "minimum": 0, "description": "UTF-8 bytes of output" },
          "output":     { "type": "string" },
          "score":      { "type": "number",  "minimum": 1, "maximum": 5 },
          "valid":      { "type": "integer", "minimum": 0, "description": "findings judged valid" },
          "invalid":    { "type": "integer", "minimum": 0, "description": "findings judged invalid" },
          "note":       { "type": "string",  "x-max-bytes": 4000 }
        }
      }
    }
  },
  "examples": [
    {
      "skill": "multi-llm-review",
      "prompt": "Review PR 12 for correctness.",
      "target": { "ref": "feat/example", "pr": "12", "diff_sha": "a1b2c3d" },
      "grader": { "model": "claude-fable-5-1", "session": "3f9c1e2a" },
      "reviewers": [
        { "slot": "sol", "model": "gpt-5.6-sol", "status": "completed", "duration_s": 241.5, "bytes": 5120, "score": 4, "valid": 3, "invalid": 1, "note": "one invalid finding about a removed flag" },
        { "slot": "glm", "model": "GLM-5.3", "status": "timeout", "duration_s": 900 }
      ]
    }
  ]
}

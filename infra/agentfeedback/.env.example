# Required credential. Fill it before starting either Compose stack; Compose
# rejects empty values and this example contains no usable credential.
# Producers send it as "Authorization: Bearer <key>" or "X-Api-Key: <key>".
API_KEY=

# Deployment stack only: the exact image to run, published by each release
# under its version (no v) and its full commit SHA.
# AGENTFEEDBACK_IMAGE=ghcr.io/agentfeedback/agentfeedback:<version-or-commit-sha>

# The HTTP port is loopback-only by default. Set to 0.0.0.0 only when an
# intentionally configured reverse proxy or firewall protects the service.
# AGENTFEEDBACK_BIND_ADDRESS=0.0.0.0

# The public base URL that /skill and the MCP server instructions name, such
# as https://feedback.example.com. Unset derives it from each request's Host
# and X-Forwarded-Proto. The service refuses to start on an unusable value.
# PUBLIC_URL=https://feedback.example.com

# Operator text appended to the MCP server instructions after a blank line.
# MCP_INSTRUCTIONS=File one report per task, in English.
